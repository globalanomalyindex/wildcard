    "explanation": "Use weighted cyclic scheduling: sorted tenant IDs expand into slots, and the cursor marks the next slot to inspect. Add preserves FIFO order and rejects any pending ID globally. Dispatch scans at most one cycle, removes the first available item, and advances immediately after its selected slot.",
    "mapping": "Tenants map to queues; weights map to repeated cycle slots; cursor maps to the next scan position; pending maps IDs to their owning tenant for global duplicate detection.",
    "assumptions": "Tenant IDs and job IDs are lowercase ASCII strings, weights are positive safe integers, and events conform to the documented add/dispatch forms.",
    "applies": "function applies(input){return !!input&&!!input.config&&!!input.config.weights&&Array.isArray(input.events)}",
    "holds": "function holds(input,out){if(!applies(input)||!Array.isArray(out)||out.length!==input.events.length)return false;var w=input.config.weights,ts=Object.keys(w).sort(),sl=[],i,j;for(i=0;i<ts.length;i++)for(j=0;j<w[ts[i]];j++)sl.push(ts[i]);var q={},p={},c=0;for(i=0;i<ts.length;i++)q[ts[i]]=[];for(i=0;i<input.events.length;i++){var e=input.events[i],st='empty',sent=null;if(e.type==='add'){if(p[e.id]!==undefined)st='duplicate';else{q[e.tenant].push(e.id);p[e.id]=e.tenant;st='queued'}}else if(e.type==='dispatch'&&sl.length){for(j=0;j<sl.length;j++){var x=(c+j)%sl.length,t=sl[x];if(q[t].length){sent=q[t].shift();delete p[sent];c=(x+1)%sl.length;st='sent';break}}}var z={};for(j=0;j<ts.length;j++)z[ts[j]]=q[ts[j]].slice();var want={status:st,sent:sent,queues:z,cursor:c};if(JSON.stringify(want)!==JSON.stringify(out[i]))return false}return true}",
    "program": "function solve(a){var w=a.config.weights,ts=Object.keys(w).sort(),s=a.state,q,p,c,sl=[],i,j;if(!s){q={};p={};c=0;for(i=0;i<ts.length;i++)q[ts[i]]=[]}else{q=s.q;p=s.p;c=s.c}for(i=0;i<ts.length;i++)for(j=0;j<w[ts[i]];j++)sl.push(ts[i]);var e=a.event,st='empty',sent=null;if(e.type==='add'){if(p[e.id]!==undefined)st='duplicate';else{q[e.tenant].push(e.id);p[e.id]=e.tenant;st='queued'}}else if(e.type==='dispatch'&&sl.length){for(j=0;j<sl.length;j++){var x=(c+j)%sl.length,t=sl[x];if(q[t].length){sent=q[t].shift();delete p[sent];c=(x+1)%sl.length;st='sent';break}}}var z={};for(i=0;i<ts.length;i++)z[ts[i]]=q[ts[i]].slice();return{state:{q:q,p:p,c:c},output:{status:st,sent:sent,queues:z,cursor:c}}}"
