    "applies": "function applies(input){return !!input&&!!input.config&&!!input.config.weights&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!applies(input)||!Array.isArray(output)||output.length!==input.events.length)return false;var w=input.config.weights,n=Object.keys(w).sort(),cy=[];for(var i=0;i<n.length;i++)for(var j=0;j<w[n[i]];j++)cy.push(n[i]);var q={};for(i=0;i<n.length;i++)q[n[i]]=[];var c=0,exp=[];for(i=0;i<input.events.length;i++){var e=input.events[i],st='queued',sent=null;if(e.type==='add'){var d=false;for(j=0;j<n.length;j++)if(q[n[j]].indexOf(e.id)>=0)d=true;if(d)st='duplicate';else q[e.tenant].push(e.id)}else{st='empty';for(j=0;j<cy.length;j++){var z=(c+j)%cy.length,t=cy[z];if(q[t].length){sent=q[t].shift();c=(z+1)%cy.length;st='sent';break}}}var qq={};for(j=0;j<n.length;j++)qq[n[j]]=q[n[j]].slice();exp.push({status:st,sent:sent,queues:qq,cursor:c})}return JSON.stringify(exp)===JSON.stringify(output)}",
    "program": "function solve(x){var cfg=x.config,w=cfg.weights,n=Object.keys(w).sort(),cy=[],i,j;for(i=0;i<n.length;i++)for(j=0;j<w[n[i]];j++)cy.push(n[i]);var s=x.state,q,c;if(!s){q={};for(i=0;i<n.length;i++)q[n[i]]=[];c=0}else{q=s.q;c=s.c}var e=x.event,st,sent=null;if(e.type==='add'){var d=false;for(i=0;i<n.length;i++)if(q[n[i]].indexOf(e.id)>=0)d=true;if(d)st='duplicate';else{q[e.tenant].push(e.id);st='queued'}}else{st='empty';for(j=0;j<cy.length;j++){var z=(c+j)%cy.length,t=cy[z];if(q[t].length){sent=q[t].shift();c=(z+1)%cy.length;st='sent';break}}}var queues={};for(i=0;i<n.length;i++)queues[n[i]]=q[n[i]].slice();return{state:{q:q,c:c},output:{status:st,sent:sent,queues:queues,cursor:c}}}"
