    "program": "function solve(x){var c=x.config,e=x.event,s=x.state;if(!s)s={now:0,phase:\"idle\",id:null,attempt:0,due:null};else s={now:s.now,phase:s.phase,id:s.id,attempt:s.attempt,due:s.due};var st=\"ignored\",send=[];if(e.type===\"start\"){if(s.phase===\"pending\"||s.phase===\"waiting\")st=\"busy\";else{s.id=e.id;s.attempt=1;s.phase=\"pending\";s.due=null;st=\"started\";send=[{id:s.id,attempt:1}]}}else if(e.type===\"fail\"){if(s.phase===\"pending\"&&e.id===s.id&&e.attempt===s.attempt){if(s.attempt>=c.attempts){s.phase=\"failed\";s.due=null;st=\"failed\"}else{s.phase=\"waiting\";s.due=s.now+Math.max(c.delay,e.after);st=\"waiting\"}}}else if(e.type===\"success\"){if(s.phase===\"pending\"&&e.id===s.id&&e.attempt===s.attempt){s.phase=\"succeeded\";s.due=null;st=\"succeeded\"}}else if(e.type===\"cancel\"){if(s.phase===\"pending\"||s.phase===\"waiting\"){s.phase=\"cancelled\";s.due=null;st=\"cancelled\"}}else if(e.type===\"advance\"){s.now+=e.dt;st=\"advanced\";if(s.phase===\"waiting\"&&s.now>=s.due){s.attempt++;s.phase=\"pending\";s.due=null;send=[{id:s.id,attempt:s.attempt}]}}return{state:s,output:{status:st,phase:s.phase,id:s.id,attempt:s.attempt,due:s.due,now:s.now,send:send}}}"
