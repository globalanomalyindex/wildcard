    "explanation": "Use the event type as the conditional rule: advance converts carry plus elapsed-rate units into whole credits; take conditionally records and debits a new affordable ID; refund conditionally restores an accepted, unrefunded cost. Other cases leave balances unchanged.",
    "mapping": "State variables map directly to capacity-limited credits, fractional carry, and an ID ledger storing each accepted cost plus refund status.",
    "assumptions": "Inputs satisfy the stated validity and safe-integer constraints. IDs are consumed permanently, including after refund; refund capping applies only to restored credits.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!Array.isArray(output))return false;var q=input.config,C=q.capacity,R=q.rate,D=q.denom,c=C,k=0,m={},e,o,i,x;for(i=0;i<input.events.length;i++){e=input.events[i];if(e.type==='advance'){x=k+e.dt*R;c=Math.min(C,c+Math.floor(x/D));k=x%D;o={status:'advanced',credits:c,carry:k}}else if(e.type==='take'){if(m[e.id]===undefined&&e.cost<=c){c-=e.cost;m[e.id]={cost:e.cost,ref:false};o={status:'taken',credits:c,carry:k}}else o={status:'rejected',credits:c,carry:k}}else{if(m[e.id]&& !m[e.id].ref){m[e.id].ref=true;c=Math.min(C,c+m[e.id].cost);o={status:'refunded',credits:c,carry:k}}else o={status:'ignored',credits:c,carry:k}}if(JSON.stringify(o)!==JSON.stringify(output[i]))return false}return output.length===input.events.length}",
    "program": "function solve(a){var q=a.config,s=a.state,e=a.event,c,k,m,x,r;if(s==null){c=q.capacity;k=0;m={}}else{c=s.c;k=s.k;m=s.m}if(e.type==='advance'){x=k+e.dt*q.rate;c=Math.min(q.capacity,c+Math.floor(x/q.denom));k=x%q.denom;r='advanced'}else if(e.type==='take'){if(m[e.id]===undefined&&e.cost<=c){c-=e.cost;m[e.id]={cost:e.cost,ref:false};r='taken'}else r='rejected'}else{if(m[e.id]!==undefined&&!m[e.id].ref){m[e.id].ref=true;c=Math.min(q.capacity,c+m[e.id].cost);r='refunded'}else r='ignored'}return{state:{c:c,k:k,m:m},output:{status:r,credits:c,carry:k}}}"
