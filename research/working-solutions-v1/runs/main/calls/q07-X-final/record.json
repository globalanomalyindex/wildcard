    "program": "function solve({config,state,event}){var s=state||{now:0,phase:'idle',id:null,attempt:0,due:null};var n={now:s.now,phase:s.phase,id:s.id,attempt:s.attempt,due:s.due},status,send=[];function ret(){return{state:n,output:{status:status,phase:n.phase,id:n.id,attempt:n.attempt,due:n.due,now:n.now,send:send}}}switch(event.type){case'start':if(n.phase==='pending'||n.phase==='waiting')status='busy';else{n.id=event.id;n.attempt=1;n.phase='pending';n.due=null;status='started';send=[{id:n.id,attempt:1}]}break;case'fail':if(n.phase!=='pending'||event.id!==n.id||event.attempt!==n.attempt)status='ignored';else if(n.attempt>=config.attempts){n.phase='failed';n.due=null;status='failed'}else{n.phase='waiting';n.due=n.now+Math.max(config.delay,event.after);status='waiting'}break;case'success':if(n.phase!=='pending'||event.id!==n.id||event.attempt!==n.attempt)status='ignored';else{n.phase='succeeded';n.due=null;status='succeeded'}break;case'cancel':if(n.phase==='pending'||n.phase==='waiting'){n.phase='cancelled';n.due=null;status='cancelled'}else status='ignored';break;case'advance':n.now+=event.dt;if(n.phase==='waiting'&&n.now>=n.due){n.attempt++;n.phase='pending';n.due=null;send=[{id:n.id,attempt:n.attempt}]}status='advanced';break}return ret()}"
