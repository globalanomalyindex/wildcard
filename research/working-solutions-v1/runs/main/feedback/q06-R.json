  "firstShown": {
    "explanation": "Apply the accounting rule directly: advances convert accumulated numerator units into credits, takes consume available credits only once per identifier, and refunds restore only accepted, unrefunded costs. The optional alignment analogy is not needed because event order is explicit.",
    "mapping": "config maps to capacity, rate, and denominator; state maps to credits, carry, and identifier records; each event maps to one status and the resulting credits/carry snapshot.",
    "assumptions": "Inputs satisfy the stated validity and safe-integer constraints. Identifier records retain accepted costs, with zero marking a completed refund.",
    "applies": "function applies(input){return true}",
    "holds": "function holds(input,output){var q=input.config,s={c:q.capacity,r:0,m:{}},e=input.events;if(!Array.isArray(output)||output.length!==e.length)return false;for(var i=0;i<e.length;i++){var x=e[i],st;if(x.type==='advance'){var n=s.r+x.dt*q.rate,k=Math.floor(n/q.denom);s.c=Math.min(q.capacity,s.c+k);s.r=n%q.denom;st='advanced'}else if(x.type==='take'){if(s.m[x.id]===undefined&&x.cost<=s.c){s.c-=x.cost;s.m[x.id]=x.cost;st='taken'}else st='rejected'}else{if(s.m[x.id]>0){s.c=Math.min(q.capacity,s.c+s.m[x.id]);s.m[x.id]=0;st='refunded'}else st='ignored'}var z=output[i];if(!z||z.status!==st||z.credits!==s.c||z.carry!==s.r||Object.keys(z).length!==3)return false}return true}",
    "program": "function solve({config,state,event}){var s=state||{c:config.capacity,r:0,m:{}};var st;if(event.type==='advance'){var n=s.r+event.dt*config.rate,k=Math.floor(n/config.denom);s.c=Math.min(config.capacity,s.c+k);s.r=n%config.denom;st='advanced'}else if(event.type==='take'){if(s.m[event.id]===undefined&&event.cost<=s.c){s.c-=event.cost;s.m[event.id]=event.cost;st='taken'}else st='rejected'}else{if(s.m[event.id]>0){s.c=Math.min(config.capacity,s.c+s.m[event.id]);s.m[event.id]=0;st='refunded'}else st='ignored'}return{state:s,output:{status:st,credits:s.c,carry:s.r}}}"
  },
