    "holds": "function(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;for(var i=0;i<output.length;i++){var o=output[i];if(!o||!('status'in o)||!('data'in o)||!('missing'in o)||!('known'in o)||!Array.isArray(o.missing)||typeof o.known!=='number')return false;if((o.status==='stored'||o.status==='cleared')&&o.data!==null)return false;if(o.status==='invalid'&&(o.data!==null||o.missing.length))return false;if(o.status==='complete'&&o.data===null)return false;if(o.status==='incomplete'&&o.data!==null)return false}return true}",
    "program": "function solve(x){var c=x.config,n=c.length,s=x.state;if(s===null){s={v:Array(n).fill(null)};}var v=s.v,e=x.event,t=e.type,o=null,m=[],d=null,i,a,b,ok;if(t==='put'){a=e.start;d=e.data;ok=Number.isInteger(a)&&a>=0&&a+d.length<=n;for(i=0;ok&&i<d.length;i++)if(d[i]<0||d[i]>255||!Number.isInteger(d[i])||(v[a+i]!==null&&v[a+i]!==d[i]))ok=false;if(ok){for(i=0;i<d.length;i++)v[a+i]=d[i];o='stored';}else o='invalid';}else if(t==='read'||t==='clear'){a=e.start;b=e.end;ok=Number.isInteger(a)&&Number.isInteger(b)&&a>=0&&a<=b&&b<=n;if(!ok)o='invalid';else if(t==='clear'){for(i=a;i<b;i++)v[i]=null;o='cleared';}else{for(i=a;i<b;i++)if(v[i]===null){var q=i;while(i<b&&v[i]===null)i++;m.push([q,i]);}if(m.length){o='incomplete';}else{o='complete';d=[];for(i=a;i<b;i++)d.push(v[i]);}}}else o='invalid';var k=0;for(i=0;i<n;i++)if(v[i]!==null)k++;if(o==='invalid')d=null;if(o==='stored'||o==='cleared'){d=null;m=[];}return{state:s,output:{status:o,data:d,missing:m,known:k}}}"
