    "explanation": "Maintain ordered frame records with persistent, one-frame, and snapshot layers. Re-expand from the initial object after each event; one-frame edits affect display only, while snapshots reset both patches.",
    "mapping": "The timeline maps to ordered frame records, carried values, persistent patches, transient patches, and snapshot boundaries.",
    "assumptions": "Inserted empty frames inherit through ordinary expansion from their current predecessor. Inputs satisfy the stated legal-value constraints.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;for(const x of output){if(!x||!Array.isArray(x.frames))return false;for(const f of x.frames)if(!f||typeof f.id!=='string'||!f.values||Array.isArray(f.values))return false}return true}",
    "program": "function cp(o){var r={};for(var k of Object.keys(o||{}))r[k]=o[k];return r}function solve(a){var s=a.state,e=a.event,c=a.config;if(s===null){s={initial:cp(c.initial),frames:c.frames.map(function(id){return{id:id,p:{},o:{},s:null}})}}var fs=s.frames,ix=-1;if(e.type==='insert'){if(e.id&&fs.every(function(f){return f.id!==e.id})){if(e.after===null)ix=0;else ix=fs.findIndex(function(f){return f.id===e.after})+1;if(ix>0||e.after===null)fs.splice(ix,0,{id:e.id,p:{},o:{},s:null})}}else{ix=fs.findIndex(function(f){return f.id===e.id});if(ix>=0){var f=fs[ix];if(e.type==='edit'){(e.scope==='persistent'?f.p:f.o)[e.key]=e.value}else if(e.type==='snapshot'){f.s=cp(e.values);f.p={};f.o={}}}}var carry=cp(s.initial),out=[];for(var f of fs){if(f.s!==null)carry=cp(f.s);for(var k of Object.keys(f.p))carry[k]=f.p[k];var v=cp(carry);for(var k of Object.keys(f.o))v[k]=f.o[k];out.push({id:f.id,values:v})}return{state:s,output:{frames:out}}}"
  },
