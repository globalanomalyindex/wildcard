    "explanation": "The conditional rule is: a response changes lifecycle state only when its ID and attempt match the currently pending job; otherwise it is ignored. Waiting retries become pending exactly once when time reaches the deadline. A terminal job may be started again.",
    "mapping": "State variables are now, phase, id, attempt, and due. Events map to transitions: start creates attempt 1 unless busy; matching fail waits or fails; matching success succeeds; cancel terminates active work; advance moves time and emits one retry when due.",
    "assumptions": "Unknown event types are treated as ignored. Cancel and advance report their specified operational status even when they make no state transition. All supplied values satisfy the stated input constraints.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!applies(input)||!Array.isArray(output)||output.length!==input.events.length)return false;var s=null;for(var i=0;i<input.events.length;i++){var r=solve({config:input.config,state:s,event:input.events[i]});if(JSON.stringify(r.output)!==JSON.stringify(output[i]))return false;s=r.state}return true}",
    "program": "function solve(x){var c=x.config,e=x.event,s=x.state;if(!s)s={n:0,p:'idle',id:null,a:0,d:null};else s={n:s.n,p:s.p,id:s.id,a:s.a,d:s.d};var z=[],st='ignored',t=e.type;if(t==='start'){if(s.p==='pending'||s.p==='waiting'){st='busy'}else{s.id=e.id;s.a=1;s.p='pending';s.d=null;z=[{id:s.id,attempt:s.a}];st='started'}}else if(t==='fail'){if(s.p==='pending'&&s.id===e.id&&s.a===e.attempt){if(s.a>=c.attempts){s.p='failed';s.d=null;st='failed'}else{s.p='waiting';s.d=s.n+Math.max(c.delay,e.after);st='waiting'}}}else if(t==='success'){if(s.p==='pending'&&s.id===e.id&&s.a===e.attempt){s.p='succeeded';s.d=null;st='succeeded'}}else if(t==='cancel'){if(s.p==='pending'||s.p==='waiting'){s.p='cancelled';s.d=null;st='cancelled'}}else if(t==='advance'){s.n+=e.dt;if(s.p==='waiting'&&s.n>=s.d){s.a++;s.p='pending';s.d=null;z=[{id:s.id,attempt:s.a}]}st='advanced'}return{state:s,output:{status:st,phase:s.p,id:s.id,attempt:s.a,due:s.d,now:s.n,send:z}}}"
  },
