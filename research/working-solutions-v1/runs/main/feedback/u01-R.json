  "firstShown": {
    "explanation": "Maintain an opaque controller state. Only the mounted, loading request matching the current ID may settle; a new search cancels the prior request first. Disposal resets data and unmounts, while mount restores the initial mounted state.",
    "mapping": "The current ID is the causal identity of the active request; query/result/error/loading are retained or replaced exactly as specified, and effects record only cancellation and request actions from the current event.",
    "assumptions": "Events are legal JSON objects under the stated contract. Unknown events are no-ops while mounted and all non-mount events are no-ops while disposed.",
    "applies": "function applies(input){return Array.isArray(input&&input.events)}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;for(const x of output){if(!x||typeof x!==\"object\"||Array.isArray(x))return false;for(const k of [\"mounted\",\"query\",\"current\",\"loading\",\"result\",\"error\",\"effects\"])if(!(k in x))return false;if(Object.keys(x).length!==7||!Array.isArray(x.effects))return false}return true}",
    "program": "function solve({config,state,event}){\n  const init=()=>({mounted:true,query:\"\",current:null,loading:false,result:null,error:null});\n  let s=state==null?init():state;\n  let effects=[];\n  const out=()=>({mounted:s.mounted,query:s.query,current:s.current,loading:s.loading,result:s.result,error:s.error,effects});\n  if(!s.mounted){\n    if(event&&event.type===\"mount\")s=init();\n    return {state:s,output:out()};\n  }\n  if(!event||typeof event!==\"object\")return {state:s,output:out()};\n  if(event.type===\"search\"){\n    if(s.loading)effects.push({type:\"cancel\",id:s.current});\n    s.current=event.id;s.query=event.query;s.loading=true;s.error=null;\n    effects.push({type:\"request\",id:event.id,query:event.query});\n  }else if(event.type===\"success\"){\n    if(s.loading&&s.current===event.id){s.result=event.result;s.error=null;s.loading=false;}\n  }else if(event.type===\"failure\"){\n    if(s.loading&&s.current===event.id){s.error=event.error;s.loading=false;}\n  }else if(event.type===\"cancel\"){\n    if(s.loading)effects.push({type:\"cancel\",id:s.current});\n    s.loading=false;s.current=null;s.error=null;\n  }else if(event.type===\"dispose\"){\n    if(s.loading)effects.push({type:\"cancel\",id:s.current});\n    s=init();s.mounted=false;\n  }\n  return {state:s,output:out()};\n}"
  },
