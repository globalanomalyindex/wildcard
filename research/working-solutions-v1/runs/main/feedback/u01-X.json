  "firstShown": {
    "explanation": "Latest-request causality: only the mounted request whose ID is current and loading may settle. New searches cancel the prior request first; disposal cancels and resets.",
    "mapping": "State tracks mounted, query, current request ID, loading, result, and error. Each event produces post-event state plus only that event's effects.",
    "assumptions": "Events use type search, success, failure, cancel, dispose, or mount. Result and error values may be any JSON value.",
    "applies": "function applies(input){return !!input&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false; return output.every(function(o){return o&&typeof o==='object'&&['mounted','query','current','loading','result','error','effects'].every(function(k){return Object.prototype.hasOwnProperty.call(o,k)})&&Array.isArray(o.effects)})}",
    "program": "function solve({config,state,event}){\n  function fresh(m){return {mounted:m,query:'',current:null,loading:false,result:null,error:null}}\n  var s=state||fresh(true), e=event||{}, fx=[];\n  if(!s.mounted){\n    if(e.type==='mount') s=fresh(true);\n    return {state:s,output:{mounted:s.mounted,query:s.query,current:s.current,loading:s.loading,result:s.result,error:s.error,effects:fx}};\n  }\n  if(e.type==='search'){\n    if(s.loading)fx.push({type:'cancel',id:s.current});\n    s={mounted:true,query:e.query,current:e.id,loading:true,result:s.result,error:null};\n    fx.push({type:'request',id:e.id,query:e.query});\n  }else if(e.type==='success'){\n    if(s.loading&&s.current===e.id){s={mounted:true,query:s.query,current:s.current,loading:false,result:e.result,error:null};}\n  }else if(e.type==='failure'){\n    if(s.loading&&s.current===e.id){s={mounted:true,query:s.query,current:s.current,loading:false,result:s.result,error:e.error};}\n  }else if(e.type==='cancel'){\n    if(s.loading){fx.push({type:'cancel',id:s.current});s={mounted:true,query:s.query,current:null,loading:false,result:s.result,error:null};}\n  }else if(e.type==='dispose'){\n    if(s.loading)fx.push({type:'cancel',id:s.current});\n    s=fresh(false);\n  }\n  return {state:s,output:{mounted:s.mounted,query:s.query,current:s.current,loading:s.loading,result:s.result,error:s.error,effects:fx}};\n}"
  },
