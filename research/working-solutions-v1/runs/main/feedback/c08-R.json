    "explanation": "Track each byte as either unknown or its stored value. A put is transactional: validate bounds and all known overlaps before writing. Reads report maximal unknown runs; clears erase the selected range.",
    "mapping": "Buffer positions map to state array entries: null means unknown, and 0..255 means known byte. known is the count of non-null entries.",
    "assumptions": "Inputs use the specified event shapes and safe integers. Initial null state denotes a fresh buffer; subsequently returned arrays are passed back unchanged.",
    "applies": "function applies(input){return !!(input&&input.config&&Array.isArray(input.events)&&input.config.length>=1)}",
    "holds": "function holds(input,output){if(!applies(input)||!Array.isArray(output)||output.length!==input.events.length)return false;var a=Array(input.config.length).fill(null),n=0;for(var k=0;k<input.events.length;k++){var e=input.events[k],d=null,m=[],s='invalid',t=e.type,x=e.start,y=e.end,i;if(t==='put'&&Array.isArray(e.data)&&Number.isInteger(x)&&x>=0&&x+e.data.length<=a.length){var ok=true;for(i=0;i<e.data.length;i++)if(a[x+i]!==null&&a[x+i]!==e.data[i])ok=false;if(ok){for(i=0;i<e.data.length;i++)if(a[x+i]===null){a[x+i]=e.data[i];n++}s='stored'}}else if((t==='read'||t==='clear')&&Number.isInteger(x)&&Number.isInteger(y)&&x>=0&&x<=y&&y<=a.length){if(t==='clear'){for(i=x;i<y;i++)if(a[i]!==null){a[i]=null;n--}s='cleared'}else{var q=x;while(q<y){if(a[q]===null){var z=q;while(z<y&&a[z]===null)z++;m.push([q,z]);q=z}else q++}if(!m.length){s='complete';d=a.slice(x,y)}}}var r={status:s,data:d,missing:m,known:n};if(JSON.stringify(r)!==JSON.stringify(output[k]))return false}return true}",
    "program": "function solve({config,state,event}){var L=config.length,a=state===null?Array(L).fill(null):state.slice(),n=0,i;if(state===null)n=0;else for(i=0;i<L;i++)if(a[i]!==null)n++;var e=event,t=e.type,s='invalid',d=null,m=[],x=e.start,y=e.end;if(t==='put'&&Array.isArray(e.data)&&Number.isInteger(x)&&x>=0&&x+e.data.length<=L){var ok=true;for(i=0;i<e.data.length;i++)if(a[x+i]!==null&&a[x+i]!==e.data[i]){ok=false;break}if(ok){for(i=0;i<e.data.length;i++)if(a[x+i]===null){a[x+i]=e.data[i];n++}s='stored'}}else if((t==='read'||t==='clear')&&Number.isInteger(x)&&Number.isInteger(y)&&x>=0&&x<=y&&y<=L){if(t==='clear'){for(i=x;i<y;i++)if(a[i]!==null){a[i]=null;n--}s='cleared'}else{var p=x;while(p<y){if(a[p]===null){var q=p;while(q<y&&a[q]===null)q++;m.push([p,q]);p=q}else p++}if(!m.length){s='complete';d=a.slice(x,y)}}}return{state:a,output:{status:s,data:d,missing:m,known:n}}}"
