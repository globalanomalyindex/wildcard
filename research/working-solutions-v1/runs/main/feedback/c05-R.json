    "explanation": "For every encode event, recursively serialize the supplied JSON value canonically: object keys are lexically sorted, arrays retain order, and primitive spellings follow ECMAScript JSON.stringify. Return that string under key and preserve no meaningful state.",
    "mapping": "The event value maps to output.key through recursive canonical encoding; state is intentionally irrelevant.",
    "assumptions": "Inputs satisfy the stated JSON-value, depth, key, and numeric restrictions. JSON.stringify provides the specified scalar and string escaping behavior.",
    "applies": "function applies(input){return !!input&&Array.isArray(input.events)&&input.events.every(function(e){return e&&e.type==='encode'&&Object.prototype.hasOwnProperty.call(e,'value')})}",
    "holds": "function holds(input,output){function c(v){if(v===null||typeof v!=='object')return JSON.stringify(v);if(Array.isArray(v))return '['+v.map(c).join(',')+']';return '{'+Object.keys(v).sort().map(function(k){return JSON.stringify(k)+':'+c(v[k])}).join(',')+'}'}return Array.isArray(output)&&output.length===input.events.length&&output.every(function(o,i){return o&&Object.keys(o).length===1&&o.key===c(input.events[i].value)})}",
    "program": "function solve(x){function c(v){if(v===null||typeof v!=='object')return JSON.stringify(v);if(Array.isArray(v)){var a=new Array(v.length);for(var i=0;i<v.length;i++)a[i]=c(v[i]);return '['+a.join(',')+']'}var k=Object.keys(v).sort(),a=new Array(k.length);for(var j=0;j<k.length;j++)a[j]=JSON.stringify(k[j])+':'+c(v[k[j]]);return '{'+a.join(',')+'}'}return {state:null,output:{key:c(x.event.value)}}}"
  },
