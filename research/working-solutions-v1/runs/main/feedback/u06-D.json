    "explanation": "Rule: an outcome may mutate visible form state only when its submission is still the current owner and its recorded revision equals the current revision; otherwise it only settles its own pending ID. A newer edit or submission changes the revision, protecting newer values. Counterexample: restoring an old submission after an edit would overwrite the newer edit.",
    "mapping": "Maps each submission ID to {before,revision}; maps global owner and revision to the authorization condition for success/failure; maps pending IDs to unsettled submissions.",
    "assumptions": "JSON values are finite and inputs satisfy the stated event and identity constraints. Object key order is irrelevant; IDs sort lexically.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||!output.length)return false;var f=JSON.parse(JSON.stringify(input.config.fields)),e=input.events[0],r=0,s='idle',p=[];if(e.type==='edit'){(e.remove||[]).forEach(function(k){delete f[k]});Object.keys(e.set||{}).forEach(function(k){f[k]=e.set[k]});r=1}else if(e.type==='submit'){(e.remove||[]).forEach(function(k){delete f[k]});Object.keys(e.set||{}).forEach(function(k){f[k]=e.set[k]});r=1;s='saving';p=[e.id]}var o=output[0];return o&&o.revision===r&&o.status===s&&JSON.stringify(o.fields)===JSON.stringify(f)&&JSON.stringify(o.pending)===JSON.stringify(p)}",
    "program": "function solve(x){var c=x.config,e=x.event,s=x.state;if(!s)s={f:JSON.parse(JSON.stringify(c.fields)),r:0,t:'idle',q:{},seen:{},own:null};function patch(f,a){(a.remove||[]).forEach(function(k){delete f[k]});Object.keys(a.set||{}).forEach(function(k){f[k]=a.set[k]})}if(e.type==='edit'){patch(s.f,e);s.r++;s.t='idle'}else if(e.type==='submit'){var id=e.id;if(!s.seen[id]){s.seen[id]=1;s.q[id]={b:JSON.parse(JSON.stringify(s.f)),r:s.r+1};patch(s.f,e);s.r++;s.own=id;s.t='saving'}}else if((e.type==='success'||e.type==='failure')&&s.q[e.id]){var z=s.q[e.id],ok=s.own===e.id&&z.r===s.r; if(ok){if(e.type==='success'){s.f=JSON.parse(JSON.stringify(e.fields));s.r++;s.t='saved'}else{s.f=z.b;s.r++;s.t='error'}s.own=null}delete s.q[e.id]}var p=Object.keys(s.q).sort(),o={fields:JSON.parse(JSON.stringify(s.f)),revision:s.r,status:s.t,pending:p};return {state:s,output:o}}"
