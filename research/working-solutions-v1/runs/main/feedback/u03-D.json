    "program": "function solve(a){var c=a.config,s=a.state,e;if(!s){e={};for(var k in c.elements)e[k]={present:!!c.elements[k].present,enabled:!!c.elements[k].enabled};s={e:e,st:[],f:c.fallback}}else{e=s.e}var v=a.event,id=v.id,ok=function(q){return q===c.fallback||(e[q]&&e[q].present&&e[q].enabled)},j;if(v.type==='element'){e[id]={present:!!v.present,enabled:!!v.enabled};if(!ok(s.f)){j=s.st.length?s.st[s.st.length-1].focus:c.fallback;s.f=ok(j)?j:c.fallback}}else if(v.type==='open'){for(j=0;j<s.st.length&&s.st[j].id!==id;j++);if(j===s.st.length){s.st.push({id:id,opener:v.opener,focus:v.focus});s.f=ok(v.focus)?v.focus:c.fallback}}else if((v.type==='close'||v.type==='complete')&&s.st.length&&s.st[s.st.length-1].id===id){var w=s.st.pop();if(ok(w.opener))s.f=w.opener;else{s.f=s.st.length?s.st[s.st.length-1].focus:c.fallback;if(!ok(s.f))s.f=c.fallback}}var stack=[],inert=[];for(j=0;j<s.st.length;j++){stack.push(s.st[j].id);if(j<s.st.length-1)inert.push(s.st[j].id)}return{state:s,output:{stack:stack,active:s.st.length?s.st[s.st.length-1].id:null,focus:s.f,inert:inert}}}"
