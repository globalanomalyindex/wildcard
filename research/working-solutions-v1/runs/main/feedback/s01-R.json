  "firstShown": {
    "explanation": "Track every accepted identity and sequence permanently. New events are rejected as stale or conflicting before insertion; accepted events are inserted, then contiguous pending sequences are applied exactly once.",
    "mapping": "state.n is the next unapplied sequence, state.v is the accumulated value, state.i maps IDs to [seq,delta], and state.q maps reserved sequence numbers to [delta].",
    "assumptions": "Events satisfy the stated legal input constraints. State is returned only to the same instance and is not externally modified.",
    "applies": "function applies(input){return Array.isArray(input.events)&&input.events.length>0}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;var n=1,v=0,ids={},qs={};for(var k=0;k<input.events.length;k++){var e=input.events[k],s=e.seq,id=e.id,d=e.delta,status;if(ids[id])status=ids[id][1]===d?'duplicate':'conflict';else if(qs[s]!==undefined)status='conflict';else if(s<n)status='stale';else{ids[id]=[s,d];qs[s]=d;status='accepted';while(qs[n]!==undefined){v+=qs[n];n++}}var p=[];for(var x in qs)if(+x>=n)p.push(+x);p.sort(function(a,b){return a-b});var o=output[k];if(!o||o.status!==status||o.value!==v||o.next!==n||JSON.stringify(o.pending)!==JSON.stringify(p))return false}return true}",
    "program": "function solve(a){var s=a.state,e=a.event;if(s===null)s={n:1,v:0,i:{},q:{}};var id=e.id,x=s.i[id],st;if(x)st=x[1]===e.delta?'duplicate':'conflict';else if(s.q[e.seq]!==undefined)st='conflict';else if(e.seq<s.n)st='stale';else{st='accepted';s.i[id]=[e.seq,e.delta];s.q[e.seq]=e.delta;while(s.q[s.n]!==undefined){s.v+=s.q[s.n];s.n++}}var p=[];for(var k in s.q)if(+k>=s.n)p.push(+k);p.sort(function(a,b){return a-b});return{state:s,output:{status:st,value:s.v,next:s.n,pending:p}}}"
  },
