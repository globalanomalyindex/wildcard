    "explanation": "A bounded retry state machine tracks one current job, its attempt, phase, deadline, and logical time. Matching responses mutate only the active pending attempt; stale responses are ignored. Waiting retries activate once when advance reaches the deadline.",
    "mapping": "The source rule directly maps config.attempts and config.delay to retry limits and deadlines, state fields to lifecycle state, and event types to transitions and output status.",
    "assumptions": "Inputs satisfy the published shape and safe-integer bounds. Only the current event and returned JSON state are used.",
    "applies": "function applies(input){return true}",
    "holds": "function holds(input,output){var c=input.config,e=input.events,s={n:0,p:'idle',i:null,a:0,d:null},r=[];function o(x){r.push({status:x,phase:s.p,id:s.i,attempt:s.a,due:s.d,now:s.n,send:[]})}for(var z of e){var t=z.type;if(t==='start'){if(s.p==='pending'||s.p==='waiting'){o('busy')}else{s.i=z.id;s.a=1;s.p='pending';s.d=null;o('started');r[r.length-1].send=[{id:s.i,attempt:1}]}}else if(t==='fail'){if(s.p!=='pending'||z.id!==s.i||z.attempt!==s.a)o('ignored');else if(s.a>=c.attempts){s.p='failed';s.d=null;o('failed')}else{s.p='waiting';s.d=s.n+Math.max(c.delay,z.after);o('waiting')}}else if(t==='success'){if(s.p!=='pending'||z.id!==s.i||z.attempt!==s.a)o('ignored');else{s.p='succeeded';s.d=null;o('succeeded')}}else if(t==='cancel'){if(s.p==='pending'||s.p==='waiting'){s.p='cancelled';s.d=null;o('cancelled')}else o('ignored')}else{ s.n+=z.dt;if(s.p==='waiting'&&s.n>=s.d){s.a++;s.p='pending';s.d=null;o('advanced');r[r.length-1].send=[{id:s.i,attempt:s.a}]}else o('advanced')}}return JSON.stringify(r)===JSON.stringify(output)}",
    "program": "function solve({config,state,event}){var s=state||{now:0,phase:'idle',id:null,attempt:0,due:null},n={now:s.now,phase:s.phase,id:s.id,attempt:s.attempt,due:s.due},status,send=[];function out(){return{state:n,output:{status:status,phase:n.phase,id:n.id,attempt:n.attempt,due:n.due,now:n.now,send:send}}}var t=event.type;if(t==='start'){if(n.phase==='pending'||n.phase==='waiting')status='busy';else{n.id=event.id;n.attempt=1;n.phase='pending';n.due=null;status='started';send=[{id:n.id,attempt:1}]}}else if(t==='fail'){if(n.phase!=='pending'||event.id!==n.id||event.attempt!==n.attempt)status='ignored';else if(n.attempt>=config.attempts){n.phase='failed';n.due=null;status='failed'}else{n.phase='waiting';n.due=n.now+Math.max(config.delay,event.after);status='waiting'}}else if(t==='success'){if(n.phase!=='pending'||event.id!==n.id||event.attempt!==n.attempt)status='ignored';else{n.phase='succeeded';n.due=null;status='succeeded'}}else if(t==='cancel'){if(n.phase==='pending'||n.phase==='waiting'){n.phase='cancelled';n.due=null;status='cancelled'}else status='ignored'}else{n.now+=event.dt;if(n.phase==='waiting'&&n.now>=n.due){n.attempt++;n.phase='pending';n.due=null;send=[{id:n.id,attempt:n.attempt}]}status='advanced'}return out()}"
