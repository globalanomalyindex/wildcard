    "explanation": "Maintains opaque lease state across events. Advance updates time before expiry processing; every event then expires leases whose deadline is reached. Acquisitions increment the persistent generation, while renew and release require the current owner and generation.",
    "program": "function solve({config,state,event}){let s=state?{now:state.now,owner:state.owner,generation:state.generation,expires:state.expires}:{now:0,owner:null,generation:0,expires:null};let t=event.type,status;if(t==='advance')s.now+=event.dt;if(s.expires!==null&&s.expires<=s.now){s.owner=null;s.expires=null}if(t==='advance')status='advanced';else if(t==='acquire'){if(s.owner===null){s.generation++;s.owner=event.owner;s.expires=s.now+config.ttl;status='acquired'}else status='busy'}else if(t==='renew'){if(s.owner!==null&&s.owner===event.owner&&s.generation===event.generation){s.expires=s.now+config.ttl;status='renewed'}else status='ignored'}else if(t==='release'){if(s.owner!==null&&s.owner===event.owner&&s.generation===event.generation){s.owner=null;s.expires=null;status='released'}else status='ignored'}return{state:s,output:{status,owner:s.owner,generation:s.generation,expires:s.expires,now:s.now}}}"
