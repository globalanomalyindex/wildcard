    "program": "function solve(x){var c=x.config,e=x.event,s=x.state;if(s===null)s={now:0,seq:0,jobs:[]};var j=s.jobs,i,k,p,b,u,status,served=[];if(e.type==='add'){for(i=0;i<j.length&&j[i].id!==e.id;i++);if(i===j.length&&j.length<c.capacity){j.push({id:e.id,w:e.work,p:e.priority,a:s.now,n:s.seq++});status='queued'}else status='rejected'}else if(e.type==='advance'){s.now+=e.dt;status='advanced'}else if(e.type==='cancel'){for(i=0;i<j.length&&j[i].id!==e.id;i++);if(i<j.length){j.splice(i,1);status='cancelled'}else status='missing'}else{if(!j.length)status='empty';else{ k=0;for(i=1;i<j.length;i++){p=Math.min(c.ceiling,j[i].p+Math.floor((s.now-j[i].a)/c.quantum));b=Math.min(c.ceiling,j[k].p+Math.floor((s.now-j[k].a)/c.quantum));if(p>b||p===b&&j[i].n<j[k].n)k=i}u=Math.min(e.budget,j[k].w);j[k].w-=u;served=[{id:j[k].id,units:u,complete:j[k].w===0}];if(j[k].w===0)j.splice(k,1);status='served'}}var pending=[],remaining={},priorities={};for(i=0;i<j.length;i++){pending.push(j[i].id);remaining[j[i].id]=j[i].w;priorities[j[i].id]=Math.min(c.ceiling,j[i].p+Math.floor((s.now-j[i].a)/c.quantum))}return{state:s,output:{now:s.now,pending:pending,priorities:priorities,remaining:remaining,served:served,status:status}}}"
