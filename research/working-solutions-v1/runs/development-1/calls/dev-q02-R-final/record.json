    "explanation": "Maintains current time, active owner, latest issued generation, and expiration in state. Advance updates time before expiration; every event then applies the specified lease operation. Expired leases clear ownership without changing generation, and renewals reset expiration from current time.",
    "program": "function solve({config,state,event}){let s=state||{now:0,owner:null,generation:0,expires:null},t=s.now,o=s.owner,g=s.generation,x=s.expires;if(event.type==='advance')t+=event.dt;if(x!==null&&x<=t){o=null;x=null}let status='ignored';if(event.type==='advance')status='advanced';else if(event.type==='acquire'){if(o===null){g++;o=event.owner;x=t+config.ttl;status='acquired'}else status='busy'}else if(event.type==='renew'){if(o!==null&&o===event.owner&&g===event.generation){x=t+config.ttl;status='renewed'}}else if(event.type==='release'){if(o!==null&&o===event.owner&&g===event.generation){o=null;x=null;status='released'}}let ns={now:t,owner:o,generation:g,expires:x};return{state:ns,output:{status:status,owner:o,generation:g,expires:x,now:t}}}"
