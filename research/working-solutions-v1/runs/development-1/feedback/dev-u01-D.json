  "firstShown": {
    "explanation": "Conditional rule: enabled edits affect only draft/error; enabled commits and steps update the committed lattice value and canonical draft; cancel always restores the committed value. Disabled mode blocks input, commit, and step but still permits cancel and mode changes. A tempting alternative is to let disabled cancel be ignored, contradicted by the specification and examples.",
    "mapping": "State variables are committed value v, draft text d, error e, disabled flag x, and immutable config c. Output derives value=v, draft=d, dirty=(d!==String(v)), error=e, disabled=x.",
    "assumptions": "Inputs satisfy the stated legal contract, including safe integer configuration arithmetic and ASCII input text. Numeric parsing rejects syntax outside optional sign plus digits and rejects non-safe results.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;for(const o of output){if(!o||Object.keys(o).length!==5||typeof o.value!=='number'||typeof o.draft!=='string'||typeof o.dirty!=='boolean'||(o.error!==null&&o.error!=='invalid')||typeof o.disabled!=='boolean')return false}return true}",
    "program": "function solve({config,state,event}){let s=state;if(s===null)s={c:config,v:config.initial,d:String(config.initial),e:null,x:false};let t=event,k=t.type;if(k==='mode'){s.x=t.disabled}else if(k==='cancel'){s.d=String(s.v);s.e=null}else if(!s.x&&k==='input'){s.d=t.text;s.e=null}else if(!s.x&&k==='commit'){let m=/^[+-]?\\d+$/.test(s.d),n=m?Number(s.d):NaN;if(!m||!Number.isSafeInteger(n)){s.e='invalid'}else{s.v=near(s.c,n);s.d=String(s.v);s.e=null}}else if(!s.x&&k==='step'){let c=s.c,q=Math.floor((s.v-c.min)/c.step)+(t.direction>0?1:-1);let z=Math.floor((c.max-c.min)/c.step);if(q<0)q=0;if(q>z)q=z;s.v=c.min+q*c.step;s.d=String(s.v);s.e=null}return{state:s,output:{value:s.v,draft:s.d,dirty:s.d!==String(s.v),error:s.e,disabled:s.x}}}function near(c,n){if(n<=c.min)return c.min;if(n>=c.max)return c.min+Math.floor((c.max-c.min)/c.step)*c.step;let q=(n-c.min)/c.step,l=Math.floor(q),a=c.min+l*c.step,b=a+c.step;return n-a<=b-n?a:b}"
  },
