    "explanation": "The rule is revision-guarded mutable state with immutable, non-reusable snapshot identities and FIFO retention. Writes and successful rollbacks advance the current revision; save and drop do not.",
    "mapping": "config.initial initializes value; config.keep bounds retained snapshot IDs; state stores value, revision, retained IDs, immutable snapshots, and permanently used IDs; event.type selects save, write, rollback, or drop.",
    "assumptions": "Inputs satisfy the stated legal schema and safe-integer bounds. Snapshot IDs are lowercase strings and keep is at least one.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!applies(input)||!Array.isArray(output)||output.length!==input.events.length)return false;let s=null;for(let i=0;i<output.length;i++){let r=solve({config:input.config,state:s,event:input.events[i]});if(JSON.stringify(r.output)!==JSON.stringify(output[i]))return false;s=r.state}return true}",
    "program": "function solve({config,state,event}){let s=state;if(s===null)s={v:config.initial,r:0,q:[],m:{},u:{}};let t=event.type,id=event.id,status;if(t==='write'){if(event.expect!==s.r)status='conflict';else{s.v=event.value;s.r++;status='written'}}else if(t==='save'){if(s.u[id])status='exists';else{s.u[id]=1;s.m[id]={value:s.v,revision:s.r};s.q.push(id);if(s.q.length>config.keep){let x=s.q.shift();delete s.m[x]}status='saved'}}else if(t==='rollback'){if(event.expect!==s.r)status='conflict';else if(!s.m[id])status='missing';else{s.v=s.m[id].value;s.r++;status='rolled_back'}}else if(t==='drop'){if(!s.m[id])status='missing';else{delete s.m[id];let i=s.q.indexOf(id);if(i>=0)s.q.splice(i,1);status='dropped'}}let saved={};for(let i=0;i<s.q.length;i++){let x=s.q[i],z=s.m[x];saved[x]={value:z.value,revision:z.revision}}return{state:s,output:{status:status,value:s.v,revision:s.r,snapshots:s.q.slice(),saved:saved}}}"
  },
