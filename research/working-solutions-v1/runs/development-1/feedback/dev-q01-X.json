  "firstShown": {
    "explanation": "A pending job ages only with elapsed clock time since acceptance; service never advances time. The implementation stores arrival time and insertion order, recomputing effective priorities on each event.",
    "mapping": "config controls capacity, ceiling, and quantum; state stores now and pending jobs; events mutate only the current scheduler state; output is a derived snapshot.",
    "assumptions": "Inputs satisfy the published validity constraints. State is supplied unchanged between events and is initially null.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){return Array.isArray(output)&&output.length===input.events.length&&output.every(function(x){return x&&typeof x==='object'&&Array.isArray(x.pending)&&x.remaining&&x.priorities&&Array.isArray(x.served)&&typeof x.now==='number'&&typeof x.status==='string'})&&(!output.length||output[0].now===0)}",
    "program": "function solve(x){var c=x.config,e=x.event,s=x.state;if(!s)s={now:0,jobs:[],seq:0};var jobs=s.jobs,n=s.now,status,served=[];function pri(j){var v=j.p+Math.floor((n-j.a)/c.quantum);return v>c.ceiling?c.ceiling:v}function snap(st){var p=[],r={},q={};for(var i=0;i<jobs.length;i++){var j=jobs[i];p.push(j.id);r[j.id]=j.w;q[j.id]=pri(j)}return {now:n,pending:p,priorities:q,remaining:r,served:served,status:st}}if(e.type==='advance'){n+=e.dt;status='advanced'}else if(e.type==='add'){var exists=false;for(var i=0;i<jobs.length;i++)if(jobs[i].id===e.id){exists=true;break}if(exists||jobs.length>=c.capacity)status='rejected';else{jobs.push({id:e.id,w:e.work,p:e.priority,a:n,k:s.seq++});status='queued'}}else if(e.type==='cancel'){var at=-1;for(var i=0;i<jobs.length;i++)if(jobs[i].id===e.id){at=i;break}if(at<0)status='missing';else{jobs.splice(at,1);status='cancelled'}}else if(e.type==='run'){if(!jobs.length)status='empty';else{var bi=0;for(var i=1;i<jobs.length;i++){var pi=pri(jobs[i]),pb=pri(jobs[bi]);if(pi>pb||pi===pb&&jobs[i].k<jobs[bi].k)bi=i}var j=jobs[bi],u=Math.min(e.budget,j.w);j.w-=u;var done=j.w===0;served=[{id:j.id,units:u,complete:done}];if(done)jobs.splice(bi,1);status='served'}}s.now=n;return {state:s,output:snap(status)}}"
  },
