  "firstShown": {
    "explanation": "Required groups auto-open their first eligible panel, while toggles and closes affect only the addressed group. Eligibility changes reconcile open panels, and expanded follows global panel order.",
    "mapping": "Groups map to one open panel or null; panels map to mutable eligibility; required groups are repaired independently after every event.",
    "assumptions": "Panel and group IDs are unique as specified. Lexicographic sorting uses JavaScript's deterministic string ordering for ASCII IDs.",
    "applies": "function applies(input){return !!(input&&input.config&&Array.isArray(input.config.groups)&&Array.isArray(input.config.panels)&&Array.isArray(input.events));}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;var ps={};for(var p of input.config.panels)ps[p.id]=1;for(var x of output){if(!x||Object.keys(x).length!==3||!x.open||!Array.isArray(x.expanded)||!Array.isArray(x.unsatisfied))return false;for(var id of x.expanded)if(!ps[id]||id.indexOf('__changed')>=0)return false;}return true;}",
    "program": "function solve({config,state,event}){var gs=config.groups,ps=config.panels,G=gs.length,P=ps.length,i,j,s;if(state===null){s={r:[],e:[],o:[]};for(i=0;i<G;i++){s.r[i]=!!gs[i].required;s.o[i]=null}for(i=0;i<P;i++)s.e[i]=!!ps[i].enabled;for(i=0;i<G;i++)if(s.r[i])for(j=0;j<P;j++)if(ps[j].group===gs[i].id&&s.e[j]){s.o[i]=ps[j].id;break}}else{s={r:state.r.slice(),e:state.e.slice(),o:state.o.slice()}}var gi=-1,pi=-1;if(event.type==='toggle'){for(i=0;i<P;i++)if(ps[i].id===event.id){pi=i;break}if(pi>=0&&s.e[pi]){for(i=0;i<G;i++)if(gs[i].id===ps[pi].group){gi=i;break}if(gi>=0){if(s.o[gi]===ps[pi].id){if(!s.r[gi])s.o[gi]=null}else s.o[gi]=ps[pi].id}}}else if(event.type==='enabled'){for(i=0;i<P;i++)if(ps[i].id===event.id){s.e[i]=!!event.value;break}}else if(event.type==='close'){for(i=0;i<G;i++)if(gs[i].id===event.group){if(!s.r[i])s.o[i]=null;break}}else if(event.type==='mode'){for(i=0;i<G;i++)if(gs[i].id===event.group){s.r[i]=!!event.required;break}}for(i=0;i<G;i++){if(s.o[i]!==null){pi=-1;for(j=0;j<P;j++)if(ps[j].id===s.o[i]&&ps[j].group===gs[i].id&&s.e[j]){pi=j;break}if(pi<0)s.o[i]=null}if(s.r[i]&&s.o[i]===null)for(j=0;j<P;j++)if(ps[j].group===gs[i].id&&s.e[j]){s.o[i]=ps[j].id;break}}var open={},expanded=[],uns=[];for(i=0;i<G;i++){open[gs[i].id]=s.o[i];if(s.r[i]&&s.o[i]===null)uns.push(gs[i].id)}uns.sort();for(i=0;i<P;i++)for(j=0;j<G;j++)if(s.o[j]===ps[i].id){expanded.push(ps[i].id);break}return{state:s,output:{open:open,expanded:expanded,unsatisfied:uns}}}"
  },
