    "explanation": "Revision-guarded state machine: accepted writes and rollbacks advance the current revision; saves capture immutable value/revision snapshots, while retention evicts only the oldest retained snapshot. Snapshot IDs remain permanently used after first save.",
    "mapping": "config.initial initializes value; config.keep bounds retained snapshots. State tracks value, revision, retained snapshots in oldest-to-newest order, and permanently used IDs.",
    "assumptions": "Inputs satisfy the stated schema and safe-integer limits. Event types are write, save, rollback, or drop; IDs are lowercase ASCII letters.",
    "applies": "function applies(input){return !!input&&!!input.config&&Number.isInteger(input.config.initial)&&Number.isInteger(input.config.keep)&&input.config.keep>=1&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;for(const x of output){if(!x||typeof x.status!==\"string\"||!Number.isSafeInteger(x.value)||!Number.isSafeInteger(x.revision)||!Array.isArray(x.snapshots)||!x.saved||typeof x.saved!==\"object\")return false;if(x.snapshots.length>input.config.keep)return false;for(const id of x.snapshots){if(typeof id!==\"string\"||!Object.prototype.hasOwnProperty.call(x.saved,id))return false;const q=x.saved[id];if(!q||!Number.isSafeInteger(q.value)||!Number.isSafeInteger(q.revision))return false}}return true}",
    "program": "function solve({config,state,event}){let s=state||{v:config.initial,r:0,a:[],u:{},m:{}};let t=event.type,id=event.id,status;if(t==='write'){if(event.expect===s.r){s.v=event.value;s.r++;status='written'}else status='conflict'}else if(t==='save'){if(s.u[id])status='exists';else{s.u[id]=1;s.m[id]={value:s.v,revision:s.r};s.a.push(id);while(s.a.length>config.keep){let z=s.a.shift();delete s.m[z]}status='saved'}}else if(t==='drop'){let i=s.a.indexOf(id);if(i<0)status='missing';else{s.a.splice(i,1);delete s.m[id];status='dropped'}}else if(t==='rollback'){if(event.expect!==s.r)status='conflict';else if(!Object.prototype.hasOwnProperty.call(s.m,id))status='missing';else{s.v=s.m[id].value;s.r++;status='rolled_back'}}let saved={};for(let k of s.a)saved[k]={value:s.m[k].value,revision:s.m[k].revision};return{state:s,output:{status,value:s.v,revision:s.r,snapshots:s.a.slice(),saved}}}"
  },
