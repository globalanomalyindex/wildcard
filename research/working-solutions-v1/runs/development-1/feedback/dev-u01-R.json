    "explanation": "The controller keeps the committed lattice value separately from the editable draft. Input edits only the draft; commit validates and snaps to the nearest legal lattice point, with ties rounded downward. Cancel and stepping restore canonical committed text.",
    "mapping": "config defines the lattice; state stores committed value, draft, error, disabled flag, and lattice parameters. Each event transforms that state and returns a derived output.",
    "assumptions": "Inputs satisfy the published config and event shapes. Numeric values are safe integers, and decimal input is ASCII with optional leading sign followed by digits.",
    "applies": "function applies(input){return true}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;var e=input.events[0],o=output[0],c=input.config;if(e&&e.type==='input'&&e.text!==String(c.initial)&&o.dirty!==true)return false;return true}",
    "program": "function solve(a){var q=a.config,e=a.event,s=a.state;if(s===null)s={v:q.initial,d:String(q.initial),x:null,z:false,mi:q.min,ma:q.max,st:q.step};var t=e.type;if(t==='mode'){s.z=e.disabled}else if(t==='input'){if(!s.z){s.d=e.text;s.x=null}}else if(t==='cancel'){s.d=String(s.v);s.x=null}else if(!s.z&&t==='commit'){var r=/^[+-]?[0-9]+$/.test(s.d),n=0;if(r){n=Number(s.d);r=Number.isSafeInteger(n)}if(!r)s.x='invalid';else{if(n<=s.mi)n=s.mi;else if(n>=s.ma)n=s.ma;else{var u=Math.floor((n-s.mi)/s.st),lo=s.mi+u*s.st,hi=lo+s.st;if(hi>s.ma)hi=s.ma;if(n-lo>hi-n)n=hi;else n=lo} s.v=n;s.d=String(n);s.x=null}}else if(!s.z&&t==='step'){var k=Math.round((s.v-s.mi)/s.st);k+=e.direction;if(k<0)k=0;var z=Math.floor((s.ma-s.mi)/s.st);if(k>z)k=z;s.v=s.mi+k*s.st;s.d=String(s.v);s.x=null}return{state:s,output:{value:s.v,draft:s.d,dirty:s.d!==String(s.v),error:s.x,disabled:s.z}}}"
  },
