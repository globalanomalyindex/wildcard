  "firstShown": {
    "explanation": "Use a bounded FIFO resident list. A live replacement preserves position and pins; tombstones block replacement. Admission evicts the oldest unpinned resident, while pinning, invalidation, and final unpinning update or remove entries.",
    "mapping": "Each resident is [key,value,pins,tombstone]. The list is FIFO order; values are readable only when tombstone is false. Capacity applies to list length, and output is derived directly from the list.",
    "assumptions": "Events are legal per the specification and config.capacity is available on each call or preserved in state. Keys are strings and values are safe integers.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){return Array.isArray(output)&&output.length===input.events.length&&output.every(function(x){return x&&Array.isArray(x.order)&&x.pins&&Array.isArray(x.tombstones)&&Object.prototype.hasOwnProperty.call(x,'value')})}",
    "program": "function solve(a){var c=a.config||{},s=a.state||{cap:c.capacity||1,r:[]},r=s.r,e=a.event,k=e.key,t=e.type,i=-1,j;for(j=0;j<r.length;j++)if(r[j][0]===k){i=j;break}var z='ignored',v=null;if(t==='put'){if(i>=0){if(r[i][3])z='blocked';else{r[i][1]=e.value;z='stored'}}else{if(r.length>=(s.cap||c.capacity)){for(j=0;j<r.length&&r[j][2]>0;j++);if(j===r.length)z='blocked';else{r.splice(j,1);r.push([k,e.value,0,false]);z='stored'}}else{r.push([k,e.value,0,false]);z='stored'}}}else if(t==='pin'){if(i>=0&&!r[i][3]){r[i][2]++;z='pinned'}}else if(t==='unpin'){if(i>=0&&r[i][2]>0){r[i][2]--;z='released';if(r[i][2]===0&&r[i][3])r.splice(i,1)}}else if(t==='invalidate'){if(i<0)z='missing';else if(r[i][2]===0){r.splice(i,1);z='invalidated'}else{r[i][3]=true;z='invalidated'}}else if(t==='get'){if(i>=0&&!r[i][3]){z='hit';v=r[i][1]}else z='miss'}var o={order:[],pins:{},status:z,tombstones:[],value:v};for(j=0;j<r.length;j++){o.order.push(r[j][0]);o.pins[r[j][0]]=r[j][2];if(r[j][3])o.tombstones.push(r[j][0])}o.tombstones.sort();return{state:{cap:s.cap||c.capacity,r:r},output:o}}"
  },
