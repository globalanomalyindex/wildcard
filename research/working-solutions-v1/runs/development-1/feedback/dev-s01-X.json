  "initialRecordSHA256": "ce997e610bf1cb362cdaaaf701005689c8c07fe5ac6f148121c5ad393f7b8026",
  "firstShown": {
    "explanation": "The state stores current time, token, deadline, approvals, and connection. Before each event, an unconnected offer expiring at the current time is cleared. Offers replace all session data; valid accepts accumulate unique configured parties; the second approval connects permanently. Cancels clear only a matching current session.",
    "mapping": "The outside rule maps to bounded session state: output is a reduced, event-visible representation of the fuller internal lifecycle. This transfer is appropriate only for retaining deadline, identity, approval, and connection distinctions required by the target contract.",
    "assumptions": "Inputs satisfy the stated legal JSON constraints. Config is available on initialization; subsequent calls provide the returned state. Party IDs are ASCII, so ordinary lexical sorting matches required scalar ordering.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)&&input.config.parties&&input.config.parties.length===2}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;for(const x of output){if(!x||x.connected==='__changed'||!Array.isArray(x.approved)||typeof x.status!=='string'||typeof x.now!=='number'||typeof x.expired!=='boolean'||!('token'in x)||!('expires'in x))return false}return true}",
    "program": "function solve({config,state,event}){\n  let s=state;\n  if(s===null)s={ttl:config.ttl,ps:[config.parties[0],config.parties[1]],now:0,token:null,expires:null,approved:[],connected:null};\n  let expired=false;\n  if(s.expires!==null&&s.now>=s.expires){s.token=null;s.expires=null;s.approved=[];s.connected=null;expired=true}\n  let status='ignored',t=event&&event.type;\n  if(t==='advance'){\n    s.now+=event.dt;\n    if(s.expires!==null&&s.now>=s.expires){s.token=null;s.expires=null;s.approved=[];s.connected=null;expired=true}\n    status='advanced';\n  }else if(t==='offer'){\n    s.token=event.token;s.expires=s.now+s.ttl;s.approved=[];s.connected=null;status='offered';\n  }else if(t==='accept'){\n    if(s.token!==null&&s.connected===null&&event.token===s.token&&(event.party===s.ps[0]||event.party===s.ps[1])){\n      if(s.approved.indexOf(event.party)>=0)status='duplicate';\n      else{s.approved.push(event.party);s.approved.sort();status='accepted';if(s.approved.length===2){s.connected=s.token;s.expires=null;status='connected'}}\n    }\n  }else if(t==='cancel'){\n    if(s.token!==null&&event.token===s.token){s.token=null;s.expires=null;s.approved=[];s.connected=null;status='cancelled'}\n  }\n  return {state:s,output:{status:status,now:s.now,token:s.token,expires:s.expires,approved:s.approved.slice(),connected:s.connected,expired:expired}};\n}"
  },
