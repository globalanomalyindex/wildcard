    "explanation": "The controller keeps committed value, draft text, validation error, and disabled mode. Inputs edit only draft; commits parse safe signed integers and snap to the nearest legal lattice value, with ties downward. Cancel and stepping canonicalize the draft.",
    "mapping": "config defines the legal lattice; state stores value, draft, error, and disabled; event selects edit, commit, step, cancel, or mode transitions; output exposes value, draft, dirty, error, and disabled.",
    "assumptions": "Inputs satisfy the published schema and numeric safety guarantees. The supplied config remains the configuration for the trace. No ambient state, timing, randomness, imports, or external effects are used.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)&&input.events.length<=48}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;for(const o of output){if(!o||typeof o!==\"object\"||Object.keys(o).sort().join(\",\")!==\"disabled,dirty,draft,error,value\"||typeof o.draft!==\"string\"||typeof o.dirty!==\"boolean\"||(o.error!==null&&o.error!==\"invalid\")||typeof o.disabled!==\"boolean\"||typeof o.value!==\"number\")return false}return output.length===0||output[0].dirty===false?false:true}",
    "program": "function solve({config,state,event}){\n const c=config;\n if(state===null)state={v:c.initial,d:String(c.initial),e:null,x:false};\n let s={v:state.v,d:state.d,e:state.e,x:state.x};\n const canon=()=>{s.d=String(s.v);s.e=null};\n const valid=t=>{if(!/^[+-]?\\d+$/.test(t))return null;let sign=1,i=0;if(t[0]=='+'||t[0]=='-'){if(t[0]=='-')sign=-1;i=1}let n=0;for(;i<t.length;i++){n=n*10+(t.charCodeAt(i)-48);if(!Number.isSafeInteger(n))return null}n*=sign;return Number.isSafeInteger(n)?n:null};\n if(event.type==='mode')s.x=event.disabled;\n else if(event.type==='cancel')canon();\n else if(!s.x&&event.type==='input'){s.d=event.text;s.e=null}\n else if(!s.x&&event.type==='commit'){\n  let n=valid(s.d);if(n===null)s.e='invalid';else{let q=(n-c.min)/c.step,k=Math.floor(q),a=c.min+k*c.step,b=a+c.step;if(k<0)s.v=c.min;else if(a>=c.max)s.v=c.max;else if(b>c.max)s.v=a;else s.v=(n-a<=b-n)?a:b;canon()}\n }\n else if(!s.x&&event.type==='step'){\n  let k=Math.round((s.v-c.min)/c.step)+(event.direction<0?-1:1),last=Math.floor((c.max-c.min)/c.step);if(k<0)k=0;if(k>last)k=last;s.v=c.min+k*c.step;canon()\n }\n return {state:s,output:{value:s.v,draft:s.d,dirty:s.d!==String(s.v),error:s.e,disabled:s.x}};\n}"
  },
