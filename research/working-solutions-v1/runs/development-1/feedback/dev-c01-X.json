  "firstShown": {
    "explanation": "Pinned FIFO residents retain insertion order. Live replacement preserves position; invalidation either removes an unpinned resident or creates a tombstone until all pins are released.",
    "mapping": "State records map each resident key to value, pin count, and tombstone status; array order is FIFO. Capacity limits records, and admission may evict only the oldest unpinned record.",
    "assumptions": "Inputs follow the stated event schema and safe-integer constraints. Output object property ordering is not semantically significant.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;var e=input.events[0];if(e&&e.type==='put'&&output[0]&&output[0].order&&output[0].order[0]!==e.key)return false;return true}",
    "program": "function solve(x){var c=x.config.capacity,s=x.state||[],e=x.event,k=e.key,t=e.type,i,r,o=null,status='ignored';function find(q){for(var j=0;j<s.length;j++)if(s[j][0]===q)return j;return -1}function remove(j){s.splice(j,1)}if(t==='put'){i=find(k);if(i>=0){if(!s[i][3]){s[i][1]=e.value;status='stored'}else{for(var z=0;z<s.length;z++)if(!s[z][2]){remove(z);s.push([k,e.value,0,false]);status='stored';break}if(status==='ignored')status='blocked'}}else if(s.length<c){s.push([k,e.value,0,false]);status='stored'}else{for(i=0;i<s.length;i++)if(!s[i][2]){remove(i);s.push([k,e.value,0,false]);status='stored';break}if(status==='ignored')status='blocked'}}else if(t==='pin'){i=find(k);if(i>=0&&!s[i][3]){s[i][2]++;status='pinned'}}else if(t==='unpin'){i=find(k);if(i>=0&&s[i][2]>0){s[i][2]--;status='released';if(s[i][2]===0&&s[i][3])remove(i)}}else if(t==='invalidate'){i=find(k);if(i<0)status='missing';else if(s[i][2]===0){remove(i);status='invalidated'}else if(!s[i][3]){s[i][3]=true;status='invalidated'}}else if(t==='get'){i=find(k);if(i>=0&&!s[i][3]){o=s[i][1];status='hit'}else status='miss'}r=[];var p={},tb=[];for(i=0;i<s.length;i++){r.push(s[i][0]);p[s[i][0]]=s[i][2];if(s[i][3])tb.push(s[i][0])}tb.sort();return{state:s,output:{order:r,pins:p,status:status,tombstones:tb,value:o}}}"
  },
