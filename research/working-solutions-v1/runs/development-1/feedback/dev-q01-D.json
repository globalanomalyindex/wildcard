  "firstShown": {
    "explanation": "The scheduler is a deterministic state machine. A pending job's priority is recomputed from its unchanged arrival time; selection compares effective priority first, then insertion rank. A run consumes only the selected job and discards unused budget after completion. Counterexample: changing the initial clock from zero violates the required initial state.",
    "mapping": "config controls capacity, ceiling, and quantum; state stores now, insertion sequence, and pending jobs; events transform that state; output is a complete projection after each event.",
    "assumptions": "Inputs satisfy all stated validity and safe-integer constraints. State is supplied exactly as previously returned by solve.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)&&input.config.capacity>=1&&input.config.quantum>=1&&input.config.ceiling>=1}",
    "holds": "function holds(input,output){if(!applies(input)||!Array.isArray(output)||output.length!==input.events.length)return false;return output.length===0||output[0]&&output[0].now===0}",
    "program": "function solve(x){var c=x.config,e=x.event,s=x.state;if(!s)s={now:0,seq:0,jobs:[]};var j=s.jobs,i,k,b,p,q,u,served=[];if(e.type==='add'){for(i=0;i<j.length;i++)if(j[i].id===e.id)break;if(i===j.length&&j.length<c.capacity){j.push({id:e.id,w:e.work,p:e.priority,a:s.now,n:s.seq++});q='queued'}else q='rejected'}else if(e.type==='advance'){s.now+=e.dt;q='advanced'}else if(e.type==='cancel'){for(i=0;i<j.length;i++)if(j[i].id===e.id)break;if(i<j.length){j.splice(i,1);q='cancelled'}else q='missing'}else if(e.type==='run'){if(!j.length)q='empty';else{ k=0;for(i=1;i<j.length;i++){p=Math.min(c.ceiling,j[i].p+Math.floor((s.now-j[i].a)/c.quantum));b=Math.min(c.ceiling,j[k].p+Math.floor((s.now-j[k].a)/c.quantum));if(p>b||p===b&&j[i].n<j[k].n)k=i}u=Math.min(e.budget,j[k].w);j[k].w-=u;served=[{id:j[k].id,units:u,complete:j[k].w===0}];if(j[k].w===0)j.splice(k,1);q='served'}}var ids=[],r={},pr={};for(i=0;i<j.length;i++){ids.push(j[i].id);r[j[i].id]=j[i].w;pr[j[i].id]=Math.min(c.ceiling,j[i].p+Math.floor((s.now-j[i].a)/c.quantum))}if(e.type!=='run')served=[];return{state:s,output:{now:s.now,pending:ids,priorities:pr,remaining:r,served:served,status:q}}}"
  },
