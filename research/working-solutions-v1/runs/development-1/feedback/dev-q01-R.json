  "firstShown": {
    "explanation": "Aging priority rises by elapsed time since acceptance, capped at ceiling. Jobs retain arrival and insertion rank through partial service; capacity and duplicate IDs reject additions.",
    "mapping": "config controls capacity, quantum, and ceiling; state stores now and pending jobs; events mutate only the current scheduler state.",
    "assumptions": "Inputs satisfy the stated legal domains and safe-integer bounds. Output object key order is not semantically significant.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;var n=0;for(var i=0;i<output.length;i++){var e=input.events[i],x=output[i];if(!x||x.now===undefined||!Array.isArray(x.pending)||!x.remaining||!x.priorities||!Array.isArray(x.served))return false;if(e.type==='advance'){n+=e.dt;if(x.now!==n)return false} else if(x.now!==n)return false}return true}",
    "program": "function solve({config,state,event}){var s=state||{now:0,j:[],seq:0};var now=s.now,j=s.j,seq=s.seq,q=config.quantum,ceil=config.ceiling,status,served=[];function find(id){for(var i=0;i<j.length;i++)if(j[i].id===id)return i;return -1}if(event.type==='advance'){now+=event.dt;status='advanced'}else if(event.type==='add'){if(j.length>=config.capacity||find(event.id)>=0)status='rejected';else{j.push({id:event.id,w:event.work,p:event.priority,a:now,r:seq++});status='queued'}}else if(event.type==='cancel'){var k=find(event.id);if(k<0)status='missing';else{j.splice(k,1);status='cancelled'}}else if(event.type==='run'){if(!j.length)status='empty';else{var k=0,best=-1;for(var i=0;i<j.length;i++){var z=Math.min(ceil,j[i].p+Math.floor((now-j[i].a)/q));if(z>best){best=z;k=i}}var x=j[k],u=Math.min(event.budget,x.w);x.w-=u;served=[{id:x.id,units:u,complete:x.w===0}];status='served';if(x.w===0)j.splice(k,1)}}var pending=[],remaining={},priorities={};for(var i=0;i<j.length;i++){var x=j[i],p=Math.min(ceil,x.p+Math.floor((now-x.a)/q));pending.push(x.id);remaining[x.id]=x.w;priorities[x.id]=p}var out={status:status,served:served,pending:pending,remaining:remaining,priorities:priorities,now:now};return{state:{now:now,j:j,seq:seq},output:out}}"
  },
