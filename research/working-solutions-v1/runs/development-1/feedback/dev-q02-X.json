  "firstShown": {
    "explanation": "Implement a renewable lease state machine. Time advances before expiry checks for advance events; every operation then expires leases at or before now. Generation increases only on successful acquisition and is never reused.",
    "mapping": "State stores now, owner, generation, and expires. The active lease is represented by non-null owner and expires; null owner and expires represent vacancy.",
    "assumptions": "config.ttl is present and valid. Events are valid contract events with safe integer values. The optional archival source does not transfer: lease behavior depends on current event order and state, not provenance.",
    "applies": "function applies(input){return Array.isArray(input.events)&&input.config&&input.config.ttl>=1}",
    "holds": "function holds(input,out){if(!applies(input)||!Array.isArray(out)||out.length!==input.events.length)return false;let s={now:0,owner:null,generation:0,expires:null},t=input.config.ttl;for(let i=0;i<out.length;i++){let e=input.events[i],x=e.type,status;if(x==='advance')s.now+=e.dt;if(s.expires!==null&&s.expires<=s.now){s.owner=null;s.expires=null}if(x==='advance')status='advanced';else if(x==='acquire'){if(s.owner===null){s.generation++;s.owner=e.owner;s.expires=s.now+t;status='acquired'}else status='busy'}else if(x==='renew'){if(s.owner!==null&&s.owner===e.owner&&s.generation===e.generation){s.expires=s.now+t;status='renewed'}else status='ignored'}else if(x==='release'){if(s.owner!==null&&s.owner===e.owner&&s.generation===e.generation){s.owner=null;s.expires=null;status='released'}else status='ignored'}else return false;let q={status,owner:s.owner,generation:s.generation,expires:s.expires,now:s.now};if(JSON.stringify(q)!==JSON.stringify(out[i]))return false}return true}",
    "program": "function solve({config,state,event}){let s=state?{now:state.now,owner:state.owner,generation:state.generation,expires:state.expires}:{now:0,owner:null,generation:0,expires:null};let status;if(event.type==='advance'){s.now+=event.dt;status='advanced'}if(s.expires!==null&&s.expires<=s.now){s.owner=null;s.expires=null}if(event.type==='acquire'){if(s.owner===null){s.generation++;s.owner=event.owner;s.expires=s.now+config.ttl;status='acquired'}else status='busy'}else if(event.type==='renew'){if(s.owner!==null&&s.owner===event.owner&&s.generation===event.generation){s.expires=s.now+config.ttl;status='renewed'}else status='ignored'}else if(event.type==='release'){if(s.owner!==null&&s.owner===event.owner&&s.generation===event.generation){s.owner=null;s.expires=null;status='released'}else status='ignored'}return{state:s,output:{status,owner:s.owner,generation:s.generation,expires:s.expires,now:s.now}}}"
  },
