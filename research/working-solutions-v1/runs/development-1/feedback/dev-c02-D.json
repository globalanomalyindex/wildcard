    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!applies(input)||!Array.isArray(output)||output.length!==input.events.length)return false;var c=input.config,v=c.initial,r=0,a=[],m={},u={},z=[];function eq(x,y){return JSON.stringify(x)===JSON.stringify(y)}function out(st){var q={};for(var i=0;i<a.length;i++)q[a[i]]={value:m[a[i]].value,revision:m[a[i]].revision};return {status:st,value:v,revision:r,snapshots:a.slice(),saved:q}}for(var i=0;i<input.events.length;i++){var e=input.events[i],st;if(e.type==='write'){if(e.expect!==r)st='conflict';else{v=e.value;r++;st='written'}}else if(e.type==='save'){if(u[e.id])st='exists';else{u[e.id]=1;m[e.id]={value:v,revision:r};a.push(e.id);if(a.length>c.keep){var x=a.shift();delete m[x]}st='saved'}}else if(e.type==='rollback'){if(e.expect!==r)st='conflict';else if(!m[e.id])st='missing';else{v=m[e.id].value;r++;st='rolled_back'}}else if(e.type==='drop'){if(!m[e.id])st='missing';else{delete m[e.id];a.splice(a.indexOf(e.id),1);st='dropped'}}else return false;z.push(out(st))}return eq(z,output)}",
    "program": "function solve(x){var c=x.config,s=x.state,e=x.event;if(s===null)s={v:c.initial,r:0,a:[],m:{},u:{}};var v=s.v,r=s.r,a=s.a,m=s.m,u=s.u,t;if(e.type==='write'){if(e.expect!==r)t='conflict';else{v=e.value;r++;t='written'}}else if(e.type==='save'){if(u[e.id])t='exists';else{u[e.id]=1;m[e.id]={value:v,revision:r};a.push(e.id);if(a.length>c.keep){var q=a.shift();delete m[q]}t='saved'}}else if(e.type==='rollback'){if(e.expect!==r)t='conflict';else if(!m[e.id])t='missing';else{v=m[e.id].value;r++;t='rolled_back'}}else if(e.type==='drop'){if(!m[e.id])t='missing';else{delete m[e.id];a.splice(a.indexOf(e.id),1);t='dropped'}}var z={};for(var i=0;i<a.length;i++)z[a[i]]={value:m[a[i]].value,revision:m[a[i]].revision};var o={status:t,value:v,revision:r,snapshots:a.slice(),saved:z};return {state:{v:v,r:r,a:a,m:m,u:u},output:o}}"
