  "firstShown": {
    "explanation": "Use a single lease record. Before each operation, advance time when requested, then expire if the deadline is reached. Acquire increments the monotonic generation only when vacant; renew and release require the current owner and generation.",
    "mapping": "state={now,owner,generation,expires}; output mirrors these fields plus status. null owner/expires represent vacancy.",
    "assumptions": "Inputs satisfy the published validity constraints; event fields are present and arithmetic remains safe.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!applies(input)||!Array.isArray(output)||output.length!==input.events.length)return false;let t=0,o=null,g=0,x=null,L=input.config.ttl;for(let i=0;i<output.length;i++){let e=input.events[i],s=output[i];if(e.type==='advance')t+=e.dt;if(x!==null&&x<=t){o=null;x=null}let z='ignored';if(e.type==='advance')z='advanced';else if(e.type==='acquire'){if(o===null){g++;o=e.owner;x=t+L;z='acquired'}else z='busy'}else if((e.type==='renew'||e.type==='release')&&o!==null&&o===e.owner&&g===e.generation){if(e.type==='renew'){x=t+L;z='renewed'}else{o=null;x=null;z='released'}}let q={status:z,owner:o,generation:g,expires:x,now:t};if(JSON.stringify(q)!==JSON.stringify(s))return false}return true}",
    "program": "function solve(a){let c=a.config,e=a.event,s=a.state||{now:0,owner:null,generation:0,expires:null};let n=s.now,o=s.owner,g=s.generation,x=s.expires;if(e.type==='advance')n+=e.dt;if(x!==null&&x<=n){o=null;x=null}let r='ignored';if(e.type==='advance')r='advanced';else if(e.type==='acquire'){if(o===null){g++;o=e.owner;x=n+c.ttl;r='acquired'}else r='busy'}else if((e.type==='renew'||e.type==='release')&&o!==null&&o===e.owner&&g===e.generation){if(e.type==='renew'){x=n+c.ttl;r='renewed'}else{o=null;x=null;r='released'}}return{state:{now:n,owner:o,generation:g,expires:x},output:{status:r,owner:o,generation:g,expires:x,now:n}}}"
  },
