  "firstShown": {
    "explanation": "A lease is identified by its owner and monotonically issued generation. Time advances first, then expiration is applied before each operation; renewal replaces the deadline from the current time.",
    "mapping": "config.ttl maps to lease duration; state stores now, owner, generation, and expires; event.type selects advance, acquire, renew, or release.",
    "assumptions": "Inputs satisfy the stated validity constraints. Null denotes no active owner or expiration.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;let t=0,o=null,g=0,x=null,L=input.config.ttl;for(let i=0;i<output.length;i++){let e=input.events[i];if(e.type==='advance')t+=e.dt;if(x!==null&&x<=t){o=null;x=null}let s='ignored';if(e.type==='advance')s='advanced';else if(e.type==='acquire'){if(o===null){g++;o=e.owner;x=t+L;s='acquired'}else s='busy'}else if(e.type==='renew'){if(o!==null&&o===e.owner&&g===e.generation){x=t+L;s='renewed'}}else if(e.type==='release'){if(o!==null&&o===e.owner&&g===e.generation){o=null;x=null;s='released'}}let z=output[i];if(!z||z.status!==s||z.now!==t||z.owner!==o||z.generation!==g||z.expires!==x)return false}return true}",
    "program": "function solve({config,state,event}){let s=state||{now:0,owner:null,generation:0,expires:null},t=s.now,o=s.owner,g=s.generation,x=s.expires;if(event.type==='advance')t+=event.dt;if(x!==null&&x<=t){o=null;x=null}let status='ignored';if(event.type==='advance')status='advanced';else if(event.type==='acquire'){if(o===null){g++;o=event.owner;x=t+config.ttl;status='acquired'}else status='busy'}else if(event.type==='renew'){if(o!==null&&o===event.owner&&g===event.generation){x=t+config.ttl;status='renewed'}}else if(event.type==='release'){if(o!==null&&o===event.owner&&g===event.generation){o=null;x=null;status='released'}}let ns={now:t,owner:o,generation:g,expires:x};return{state:ns,output:{status:status,owner:o,generation:g,expires:x,now:t}}}"
  },
