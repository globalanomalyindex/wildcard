    "program": "function solve(x){let s=x.state||[],e=x.event,c=x.config.capacity,k=e.key,t=e.type,i=-1;for(let j=0;j<s.length;j++)if(s[j][0]===k){i=j;break}let z=\"ignored\",v=null;if(t===\"put\"){if(i>=0){if(s[i][3])z=\"blocked\";else{s[i][1]=e.value;z=\"stored\"}}else{if(s.length>=c){let q=-1;for(let j=0;j<s.length;j++)if(s[j][2]===0){q=j;break}if(q<0)z=\"blocked\";else{s.splice(q,1);s.push([k,e.value,0,0]);z=\"stored\"}}else{s.push([k,e.value,0,0]);z=\"stored\"}}}else if(t===\"pin\"){if(i>=0&&!s[i][3]){s[i][2]++;z=\"pinned\"}}else if(t===\"unpin\"){if(i>=0&&s[i][2]>0){s[i][2]--;z=\"released\";if(s[i][3]&&s[i][2]===0)s.splice(i,1)}}else if(t===\"invalidate\"){if(i<0)z=\"missing\";else if(s[i][2]===0){s.splice(i,1);z=\"invalidated\"}else{if(!s[i][3]){s[i][3]=1;z=\"invalidated\"}}}else if(t===\"get\"){if(i>=0&&!s[i][3]){v=s[i][1];z=\"hit\"}else z=\"miss\"}let order=[],pins={},ts=[];for(let a of s){order.push(a[0]);pins[a[0]]=a[2];if(a[3])ts.push(a[0])}ts.sort();return{state:s,output:{order:order,pins:pins,status:z,tombstones:ts,value:v}}}"
