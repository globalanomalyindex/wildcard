  "firstShown": {
    "explanation": "The rendezvous rule is: a pending offer is valid only before its deadline; matching accepted parties connect it, while cancellation or expiration clears it. Connected sessions do not expire.",
    "mapping": "config.ttl defines the deadline interval; config.parties defines the only valid approvers. State tracks now, token, expires, approved parties, and connected token. Events mutate these variables and produce the documented snapshot.",
    "assumptions": "Inputs follow the stated legal JSON contract. Unknown or malformed events are ignored without changing session state. Party IDs are ASCII, so native lexicographic sorting matches the required order.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;for(const x of output){if(!x||x.connected==='__changed'||!Array.isArray(x.approved))return false;for(const k of ['status','now','token','expires','connected','expired'])if(!(k in x))return false}return true}",
    "program": "function solve({config,state,event}){let s=state==null?[0,null,null,[],null]:state;let n=s[0],tok=s[1],ex=s[2],ap=s[3],con=s[4],expired=false;const t=event&&event.type;if(t==='advance'){n+=event.dt;if(tok!==null&&con===null&&ex!==null&&n>=ex){tok=null;ex=null;ap=[];con=null;expired=true}}else if(tok!==null&&con===null&&ex!==null&&n>=ex){tok=null;ex=null;ap=[];con=null;expired=true}let status='ignored';if(t==='offer'&&typeof event.token==='string'){tok=event.token;ex=n+config.ttl;ap=[];con=null;status='offered'}else if(t==='accept'&&typeof event.token==='string'&&event.token===tok&&con===null&&ex!==null&&config.parties.indexOf(event.party)>=0){if(ap.indexOf(event.party)>=0)status='duplicate';else{ap=ap.concat([event.party]).sort();status='accepted';if(ap.length===2){con=tok;ex=null;status='connected'}}}else if(t==='cancel'&&typeof event.token==='string'&&event.token===tok&&tok!==null){tok=null;ex=null;ap=[];con=null;status='cancelled'}else if(t==='advance')status='advanced';s=[n,tok,ex,ap,con];return{state:s,output:{status,now:n,token:tok,expires:ex,approved:ap,connected:con,expired}}}"
  },
