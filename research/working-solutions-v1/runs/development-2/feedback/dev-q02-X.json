  "firstShown": {
    "explanation": "Maintain a logical clock, monotonically increasing generation, and at most one active lease. Advance updates time before expiration is checked; every other operation checks expiration first. Renew replaces the deadline from the current time.",
    "mapping": "state stores now, owner, generation, and expires. config.ttl controls each new deadline. event.type selects advance, acquire, renew, or release.",
    "assumptions": "Inputs satisfy the stated schema and safe-integer constraints. Unknown event types are not supplied.",
    "applies": "function applies(input){return true}",
    "holds": "function holds(input,output){let t=0,o=null,g=0,x=null,L=input.config.ttl;let eq=(a,b)=>JSON.stringify(a)===JSON.stringify(b);let r=[];for(let e of input.events){if(e.type==='advance'){t+=e.dt;if(o!==null&&x<=t){o=null;x=null}r.push({status:'advanced',owner:o,generation:g,expires:x,now:t});continue}if(o!==null&&x<=t){o=null;x=null}let s='ignored';if(e.type==='acquire'){if(o===null){g++;o=e.owner;x=t+L;s='acquired'}else s='busy'}else if(e.type==='renew'){if(o!==null&&o===e.owner&&g===e.generation){x=t+L;s='renewed'}}else if(e.type==='release'){if(o!==null&&o===e.owner&&g===e.generation){o=null;x=null;s='released'}}r.push({status:s,owner:o,generation:g,expires:x,now:t})}return eq(r,output)}",
    "program": "function solve({config,state,event}){let s=state||{now:0,owner:null,generation:0,expires:null},t=s.now,o=s.owner,g=s.generation,x=s.expires,L=config.ttl;if(event.type==='advance'){t+=event.dt;if(o!==null&&x<=t){o=null;x=null}return {state:{now:t,owner:o,generation:g,expires:x},output:{status:'advanced',owner:o,generation:g,expires:x,now:t}}}if(o!==null&&x<=t){o=null;x=null}let status='ignored';if(event.type==='acquire'){if(o===null){g++;o=event.owner;x=t+L;status='acquired'}else status='busy'}else if(event.type==='renew'){if(o!==null&&o===event.owner&&g===event.generation){x=t+L;status='renewed'}}else if(event.type==='release'){if(o!==null&&o===event.owner&&g===event.generation){o=null;x=null;status='released'}}return {state:{now:t,owner:o,generation:g,expires:x},output:{status,owner:o,generation:g,expires:x,now:t}}}"
  },
