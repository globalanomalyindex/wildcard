  "firstShown": {
    "explanation": "Maintain one open panel per group, enforce enabled eligibility, and refill required groups using fixed panel order after every event.",
    "mapping": "Groups map to requirement and open-panel state; panels map to group and enabled eligibility. Expanded and unsatisfied are derived outputs.",
    "assumptions": "IDs are valid as specified. Required-group sorting uses ascending Unicode string order.",
    "applies": "function applies(input){return !!input&&!!input.config&&Array.isArray(input.events)}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;return output.every(x=>x&&typeof x==='object'&&Array.isArray(x.expanded)&&Array.isArray(x.unsatisfied)&&x.open&&typeof x.open==='object'&&!Object.keys(x).some(k=>!['open','expanded','unsatisfied'].includes(k))&&!x.expanded.some(id=>typeof id!=='string'||id.includes('__changed')))}",
    "program": "function solve({config,state,event}){\n  const G=config.groups,P=config.panels;\n  let s=state;\n  if(s===null){s={e:P.map(p=>!!p.enabled),o:G.map(()=>null),r:G.map(g=>!!g.required)};for(let i=0;i<G.length;i++)if(s.r[i])for(let j=0;j<P.length;j++)if(P[j].group===G[i].id&&s.e[j]){s.o[i]=P[j].id;break}}\n  const gi=id=>{for(let i=0;i<G.length;i++)if(G[i].id===id)return i;return -1};\n  const pi=id=>{for(let i=0;i<P.length;i++)if(P[i].id===id)return i;return -1};\n  if(event&&event.type==='toggle'){let j=pi(event.id);if(j>=0&&s.e[j]){let i=gi(P[j].group);if(i>=0){if(s.o[i]===P[j].id){if(!s.r[i])s.o[i]=null}else s.o[i]=P[j].id}}}\n  else if(event&&event.type==='enabled'){let j=pi(event.id);if(j>=0)s.e[j]=!!event.value}\n  else if(event&&event.type==='close'){let i=gi(event.group);if(i>=0&&!s.r[i])s.o[i]=null}\n  else if(event&&event.type==='mode'){let i=gi(event.group);if(i>=0)s.r[i]=!!event.required}\n  for(let i=0;i<G.length;i++){let j=pi(s.o[i]);if(j<0||!s.e[j])s.o[i]=null;if(s.o[i]===null&&s.r[i])for(let k=0;k<P.length;k++)if(P[k].group===G[i].id&&s.e[k]){s.o[i]=P[k].id;break}}\n  let open={},expanded=[];for(let i=0;i<G.length;i++)open[G[i].id]=s.o[i];for(let j=0;j<P.length;j++)for(let i=0;i<G.length;i++)if(s.o[i]===P[j].id)expanded.push(P[j].id);\n  let unsatisfied=[];for(let i=0;i<G.length;i++)if(s.r[i]&&s.o[i]===null)unsatisfied.push(G[i].id);unsatisfied.sort();\n  return {state:s,output:{open,expanded,unsatisfied}};\n}"
  },
