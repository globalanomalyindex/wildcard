    "explanation": "A pending offer is a lease: each event first advances time when applicable, then expires an unconnected lease at its deadline. Offers replace all prior state; valid unique approvals accumulate; both parties connect permanently. Matching cancellation clears either session, while stale messages are ignored.",
    "mapping": "config.ttl and config.parties define lease duration and authorized identities. State stores current time, token, deadline, approvals, connection, and configuration. Each output reflects post-event state plus whether expiration occurred during that event.",
    "assumptions": "Inputs satisfy the stated legal contract; unknown or malformed events are treated as ignored without changing state, except that any required expiration still occurs first. Approval output is sorted by Unicode scalar-value order.",
    "applies": "function applies(input){return Array.isArray(input.events)&&input.config&&Array.isArray(input.config.parties)&&input.config.parties.length===2}",
    "holds": "function holds(input,output){if(!Array.isArray(output)||output.length!==input.events.length)return false;return output.every(x=>x&&typeof x.status==='string'&&Number.isSafeInteger(x.now)&&typeof x.expired==='boolean'&&Array.isArray(x.approved)&&Object.keys(x).length===7)}",
    "program": "function solve({config,state,event}){var s=state;if(s===null)s={q:config.ttl,p:config.parties.slice(),n:0,t:null,x:null,a:[],c:null};var e=event||{},z=false;if(e.type==='advance'){s.n+=e.dt}if(s.c===null&&s.t!==null&&s.n>=s.x){s.t=null;s.x=null;s.a=[];z=true}var r='ignored';if(e.type==='offer'){s.t=e.token;s.x=s.n+s.q;s.a=[];s.c=null;r='offered'}else if(e.type==='accept'){if(s.c===null&&s.t!==null&&e.token===s.t&&(e.party===s.p[0]||e.party===s.p[1])){if(s.a.indexOf(e.party)>=0)r='duplicate';else{s.a.push(e.party);r='accepted';if(s.a.length===2){s.a.sort(cmp);s.c=s.t;s.x=null;r='connected'}}}}else if(e.type==='cancel'){if(s.t!==null&&e.token===s.t){s.t=null;s.x=null;s.a=[];s.c=null;r='cancelled'}}else if(e.type==='advance')r='advanced';s.a.sort(cmp);return{state:s,output:{status:r,now:s.n,token:s.t,expires:s.x,approved:s.a.slice(),connected:s.c,expired:z}}}function cmp(a,b){var i=0,j=0;while(i<a.length&&j<b.length){var x=a.codePointAt(i),y=b.codePointAt(j);if(x!==y)return x-y;i+=x>65535?2:1;j+=y>65535?2:1}return a.length-i-(b.length-j)}"
  },
