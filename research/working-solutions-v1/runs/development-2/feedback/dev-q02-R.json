    "explanation": "Maintain the current clock, active owner, lease deadline, and highest issued generation. Advance first changes time, then expiration is checked before the operation. Acquisition is vacant-only; renewal and release require the exact owner and generation.",
    "mapping": "config.ttl maps to lease duration; state stores now, owner, generation, and expires. Each event produces the documented status snapshot.",
    "assumptions": "Inputs satisfy the stated schema and safe-integer bounds. Event identifiers are compared by ordinary JSON string equality.",
    "applies": "function applies(input){return !!(input&&input.config&&Array.isArray(input.events));}",
    "holds": "function holds(input,output){if(!applies(input)||!Array.isArray(output)||output.length!==input.events.length)return false;var t=0,o=null,g=0,x=null,ttl=input.config.ttl;for(var i=0;i<input.events.length;i++){var e=input.events[i],status;if(e.type==='advance'){t+=e.dt;status='advanced';}else if(e.type==='acquire'){if(x!==null&&x<=t){o=null;x=null;}if(o===null){g++;o=e.owner;x=t+ttl;status='acquired';}else status='busy';}else if(e.type==='renew'){if(x!==null&&x<=t){o=null;x=null;}if(o!==null&&o===e.owner&&g===e.generation){x=t+ttl;status='renewed';}else status='ignored';}else if(e.type==='release'){if(x!==null&&x<=t){o=null;x=null;}if(o!==null&&o===e.owner&&g===e.generation){o=null;x=null;status='released';}else status='ignored';}else return false;var z=output[i];if(!z||z.status!==status||z.now!==t||z.owner!==o||z.generation!==g||z.expires!==x)return false;}return true;}",
    "program": "function solve({config,state,event}){var s=state||{now:0,owner:null,generation:0,expires:null},e=event,t=s.now,o=s.owner,g=s.generation,x=s.expires,status;if(e.type==='advance'){t+=e.dt;status='advanced';}else{if(x!==null&&x<=t){o=null;x=null;}if(e.type==='acquire'){if(o===null){g++;o=e.owner;x=t+config.ttl;status='acquired';}else status='busy';}else if(e.type==='renew'){if(o!==null&&o===e.owner&&g===e.generation){x=t+config.ttl;status='renewed';}else status='ignored';}else if(e.type==='release'){if(o!==null&&o===e.owner&&g===e.generation){o=null;x=null;status='released';}else status='ignored';}}var ns={now:t,owner:o,generation:g,expires:x};return {state:ns,output:{status:status,owner:o,generation:g,expires:x,now:t}};}"
