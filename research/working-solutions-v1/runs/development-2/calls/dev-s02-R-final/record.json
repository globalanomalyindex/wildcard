    "program": "function solve({config,state,event}){if(state===null)state={v:0,values:Object.assign({},config.initial),cap:config.capacity};var val=state.values,v=state.v,g=event.guards,u=event.updates,invalid=false,ks=Object.keys(g),us=Object.keys(u),i;for(i=0;i<ks.length;i++)if(!Object.prototype.hasOwnProperty.call(val,ks[i]))invalid=true;for(i=0;i<us.length;i++)if(!Object.prototype.hasOwnProperty.call(g,us[i])||u[us[i]]<0)invalid=true;var status,changed=[];if(invalid)status='invalid';else if(event.version!==v)status='stale';else{for(i=0;i<ks.length;i++)if(val[ks[i]]!==g[ks[i]]){status='conflict';break}if(!status){var cand=Object.assign({},val);for(i=0;i<us.length;i++)cand[us[i]]=u[us[i]];var sum=0,ck=Object.keys(cand);for(i=0;i<ck.length;i++)sum+=cand[ck[i]];if(sum>state.cap)status='capacity';else{for(i=0;i<us.length;i++)if(val[us[i]]!==cand[us[i]])changed.push(us[i]);changed.sort(function(a,b){var A=Array.from(a),B=Array.from(b),n=Math.min(A.length,B.length),j;for(j=0;j<n;j++){var d=A[j].codePointAt(0)-B[j].codePointAt(0);if(d)return d}return A.length-B.length});if(changed.length){val=cand;v++;status='committed'}else status='unchanged'}}}return{state:{v:v,values:val,cap:state.cap},output:{status:status,version:v,values:Object.assign({},val),changed:status==='committed'?changed:[]}}}"
