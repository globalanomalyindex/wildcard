    "program": "function solve({config,state,event}){let s=state;if(s===null){s={v:config.initial,d:String(config.initial),e:null,x:false,min:config.min,max:config.max,step:config.step}}else if(!s.min&&s.min!==0){s.min=config.min;s.max=config.max;s.step=config.step}const t=event&&event.type;if(t==='mode'){s.x=event.disabled}else if(t==='cancel'){s.d=String(s.v);s.e=null}else if(!s.x&&t==='input'){s.d=event.text;s.e=null}else if(!s.x&&t==='commit'){const m=/^[+-]?\\d+$/.test(s.d);let n=m?Number(s.d):NaN;if(!m||!Number.isSafeInteger(n)){s.e='invalid'}else{let q=Math.floor((s.max-s.min)/s.step),z=Math.floor((n-s.min)/s.step);if(z<0)z=0;if(z>q)z=q;let a=s.min+z*s.step,b=z<q?a+s.step:a;if(z<q&&Math.abs(n-a)>Math.abs(b-n))a=b;s.v=a;s.d=String(a);s.e=null}}else if(!s.x&&t==='step'){let q=Math.floor((s.max-s.min)/s.step),k=Math.round((s.v-s.min)/s.step)+(event.direction<0?-1:1);if(k<0)k=0;if(k>q)k=q;s.v=s.min+k*s.step;s.d=String(s.v);s.e=null}return{state:s,output:{value:s.v,draft:s.d,dirty:s.d!==String(s.v),error:s.e,disabled:s.x}}}"
